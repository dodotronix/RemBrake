	(text_box "The ~{ALCC} pin defaults to output mode, \nwhich can cause leakage current into \nthe 3.3V power rail.\nTo prevent this, we manually calibrate \nthe chip by writing the maximum value \nwhen the battery is fully charged, \nusing the pull-up resistor."
		(exclude_from_sim no)
		(at 24.13 19.05 0)
		(size 41.275 17.78)
